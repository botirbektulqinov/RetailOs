# RetailOS backend — environment template.
#
# Copy to `.env` for local development:   cp .env.example .env
# Every variable here is validated at startup by src/config/env.schema.ts.
# The application refuses to boot if anything is missing or malformed.
#
# NEVER commit a real .env. .gitignore already excludes it.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ── Database ──────────────────────────────────────────────────────────────────
# The dev container publishes on 55432, not 5432, so it cannot collide with a
# PostgreSQL already installed on the host. Change POSTGRES_PORT in .env and
# this URL together if you move it.
DATABASE_URL=postgresql://retailos:retailos@localhost:55432/retailos?schema=public
DATABASE_POOL_SIZE=10

# Consumed by docker-compose.yml only.
POSTGRES_USER=retailos
POSTGRES_PASSWORD=retailos
POSTGRES_DB=retailos
POSTGRES_PORT=55432

# ── Auth (wired up in Sprint 2) ───────────────────────────────────────────────
# Minimum 32 characters. A value containing "dev-only" is REJECTED when
# NODE_ENV=production, so the placeholder below cannot reach production.
#
# The placeholders below are fine for `npm run start:dev`. The FULL Docker
# stack (`docker compose up`) runs the production image with NODE_ENV=production
# and will refuse to start until you replace them with real values:
#   openssl rand -base64 48
# (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=dev-only-jwt-secret-change-me-32-bytes-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. Must be non-empty in production. Never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Enable only when running behind a reverse proxy, so client IPs are real.
TRUST_PROXY=false
BODY_LIMIT=1mb

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=600

# ── Observability ─────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── Docs ──────────────────────────────────────────────────────────────────────
# Keep false in production unless the API docs are deliberately public.
SWAGGER_ENABLED=true

# Credential endpoints (login, refresh, change-password) get their own, much
# tighter budget than ordinary reads.
AUTH_RATE_LIMIT=5
AUTH_RATE_LIMIT_TTL_SECONDS=900
