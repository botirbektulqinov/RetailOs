// RetailOS — Prisma schema.
//
// Sprint 2 scope: identity, tenancy, store context and RBAC. Catalog,
// inventory and selling models stay in prisma/schema.draft.prisma and are
// promoted by the sprint that implements them (docs/ARCHITECTURE.md §33).
//
// Naming convention (docs/ARCHITECTURE.md §5.1):
//   - Prisma models  PascalCase, fields camelCase
//   - tables/columns snake_case via @@map / @map
//   - enums          SCREAMING_SNAKE values
// The connection URL lives in prisma.config.ts (Prisma 7 no longer allows
// `url` in the schema); the runtime connects through the pg driver adapter.
//
// Constraints Prisma cannot express — partial unique indexes, CHECKs, the
// append-only trigger on audit_log — live in the hand-written portion of the
// migration. See docs/ARCHITECTURE.md §6.2.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext, pg_trgm]
}

// ──────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

/// SUSPENDED is distinct from INACTIVE: inactive is an ordinary "not working
/// here right now", suspended is a security action. Both block login; only the
/// reason and who may reverse it differ.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ──────────────────────────────────────────────────────────────────────────
// Tenancy
// ──────────────────────────────────────────────────────────────────────────

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  slug         String             @unique
  currencyCode String             @default("UZS") @map("currency_code") @db.Char(3)
  status       OrganizationStatus @default(ACTIVE)

  /// Seat limit. The design's employees screen renders "8 / 10 foydalanuvchi
  /// band", so the limit is a real product concept, not a billing hook.
  maxUsers Int @default(10) @map("max_users")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings    OrganizationSettings?
  stores      Store[]
  users       User[]
  roles       Role[]
  memberships StoreMembership[]
  auditLogs   AuditLog[]

  @@map("organization")
}

model OrganizationSettings {
  organizationId      String  @id @map("organization_id") @db.Uuid
  currencyExponent    Int     @default(0) @map("currency_exponent") @db.SmallInt
  cashRoundingUnit    BigInt  @default(0) @map("cash_rounding_unit")
  allowNegativeStock  Boolean @default(false) @map("allow_negative_stock")
  defaultDebtTermDays Int     @default(30) @map("default_debt_term_days") @db.SmallInt
  loyaltyEarnPercent  Decimal @default(0) @map("loyalty_earn_percent") @db.Decimal(5, 2)
  loyaltyPointValue   BigInt  @default(1) @map("loyalty_point_value")
  returnWindowDays    Int     @default(14) @map("return_window_days") @db.SmallInt
  timezone            String  @default("Asia/Tashkent")
  locale              String  @default("uz-UZ")
  version             Int     @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Store {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Human branch code. The design shows "FILIAL #017" on the store screen.
  code    String
  name    String
  address String?
  phone   String?

  /// "Rekvizitlar" block on the store screen: legal entity name, STIR (the
  /// Uzbek taxpayer identification number) and opening hours.
  legalName    String? @map("legal_name")
  taxId        String? @map("tax_id")
  workingHours String? @map("working_hours")

  /// Stores inherit the organization's timezone unless they override it — a
  /// chain can span Tashkent and Nukus.
  timezone String?

  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  warehouses   Warehouse[]
  memberships  StoreMembership[]
  sales        Sale[]
  purchases    Purchase[]

  // Every tenant model carries this compound unique so a scoped lookup can
  // never be written as a bare findUnique({ where: { id } }) — see §4.3.
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("store")
}

/// Stock lives in a warehouse, never directly in a store. Introduced now, with
/// one auto-created per store, because retrofitting warehouse_id onto a live
/// inventory ledger later would mean migrating every movement ever written.
model Warehouse {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  storeId        String? @map("store_id") @db.Uuid

  code      String
  name      String
  isDefault Boolean @default(false) @map("is_default")

  /// null = inherit organization_settings.allow_negative_stock
  allowNegativeStock Boolean?  @map("allow_negative_stock")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store? @relation(fields: [storeId], references: [id])

  levels       InventoryLevel[]
  movements    InventoryMovement[]
  counts       InventoryCount[]
  transfersOut StockTransfer[]     @relation("TransferOut")
  transfersIn  StockTransfer[]     @relation("TransferIn")

  @@unique([organizationId, id])
  @@index([organizationId, storeId])
  @@map("warehouse")
}

// ──────────────────────────────────────────────────────────────────────────
// Identity
// ──────────────────────────────────────────────────────────────────────────

model User {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// The login identifier. The design's auth flow is phone-first (+998 …) and
  /// the employees screen searches "Ism yoki telefon bo'yicha", so phone is
  /// required and unique; email is optional contact detail.
  /// Stored E.164 normalised (+998901234567) so lookup is exact.
  phone    String
  email    String? @db.Citext
  fullName String  @map("full_name")

  passwordHash String @map("password_hash")

  /// Drives "90 kun oldin yangilangan" on the security screen.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)

  /// Bumped on password change, deactivation and role change. Every issued
  /// access token carries it, so a stale token is rejected on its next request
  /// instead of living out its 15 minutes.
  tokenVersion Int @default(0) @map("token_version")

  /// The security screen's "Ikki bosqichli himoya · SMS kod orqali" toggle.
  /// Stored now; SMS delivery is deferred (see README security notes).
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id])
  memberships   StoreMembership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@unique([organizationId, id])
  // Phone is globally unique, not per-organization: login is a single field
  // with no tenant selector, so the same number cannot identify two accounts.
  // Documented in ARCHITECTURE §35.4.
  @@unique([phone])
  @@index([organizationId, status])
  @@index([organizationId, fullName])
  @@map("app_user")
}

/// A user's authority is per store. The same person can be MANAGER at one
/// branch and CASHIER at another, which a role column on User cannot express
/// and which becomes a painful migration once sales reference the role.
model StoreMembership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  /// The store a fresh session lands in when none is requested.
  isPrimary Boolean      @default(false) @map("is_primary")
  status    EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId])
  @@unique([organizationId, id])
  @@index([organizationId, storeId, status])
  @@index([roleId])
  @@map("store_membership")
}

// ──────────────────────────────────────────────────────────────────────────
// RBAC
// ──────────────────────────────────────────────────────────────────────────

/// Permissions are a typed constant in code (src/rbac/permissions.ts), not a
/// table: a permission no guard references is meaningless, and a guard naming
/// a permission that does not exist should be a compile error rather than a
/// silently-false check. See ARCHITECTURE §2.2 and §20.1.
model Role {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Stable machine code (ADMIN, MANAGER, CASHIER, WAREHOUSE, or a slug for
  /// custom roles). Authorization never reads this — it reads `permissions`.
  code String

  /// Display name and one-line summary, both shown on the roles screen
  /// ("Administrator" / "Barcha bo'limlar").
  name        String
  description String?

  permissions String[] @default([])

  /// System roles are seeded per organization and cannot be deleted. ADMIN
  /// additionally cannot have its permissions edited.
  isSystem Boolean @default(false) @map("is_system")

  /// Bumped whenever `permissions` changes. It is part of the permission cache
  /// key and is carried in the access token, so a revoked permission takes
  /// effect on the very next request rather than after the token expires.
  permissionVersion Int @default(0) @map("permission_version")

  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  memberships  StoreMembership[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("role")
}

// ──────────────────────────────────────────────────────────────────────────
// Sessions
// ──────────────────────────────────────────────────────────────────────────

/// One row per active session. The security screen lists these as "Faol
/// qurilmalar · 3 ta qurilma" and offers "Barcha qurilmalardan chiqish".
model RefreshToken {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque token. The token itself is never stored, so a
  /// database leak does not hand over live sessions.
  tokenHash String @unique @map("token_hash")

  /// Rotation family. Presenting an already-rotated token means it was stolen,
  /// so the whole family is revoked at once (§29.2).
  familyId     String  @map("family_id") @db.Uuid
  replacedById String? @map("replaced_by_id") @db.Uuid

  /// Coarse label derived from the User-Agent ("iPhone · Safari"). Deliberately
  /// not a fingerprint — enough to recognise a device, not to track one.
  deviceName String? @map("device_name")
  ip         String?

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
}

// ──────────────────────────────────────────────────────────────────────────
// Audit
// ──────────────────────────────────────────────────────────────────────────

/// Append-only. UPDATE and DELETE are blocked by trigger in the migration.
model AuditLog {
  id             BigInt  @id @default(autoincrement())
  organizationId String  @map("organization_id") @db.Uuid
  storeId        String? @map("store_id") @db.Uuid

  /// null = the system acted (cron, webhook), not a person.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// noun.verb, past tense: 'auth.login_failed', 'role.permissions_changed'.
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  /// Explicitly constructed, never a dumped DTO — that is how secrets end up
  /// in a table nobody can delete from (§21.4).
  metadata Json @default("{}")

  ip        String?
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  /// RESTRICT, not the implicit SET NULL: nulling the actor is an UPDATE on an
  /// append-only table and the trigger rejects it, which surfaces as a
  /// baffling error at the delete site. Users are never deleted in this
  /// product anyway — they are deactivated, so their sales and their audit
  /// trail keep naming them.
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  @@index([organizationId, actorUserId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ──────────────────────────────────────────────────────────────────────────
// Catalog (Sprint 3)
// ──────────────────────────────────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// Sellable unit of measure. Decides whether a fractional quantity is legal:
/// you can sell 1.5 kg of rice, not 1.5 phone chargers.
enum Unit {
  PIECE
  KG
  LITRE
  METRE
  PACK
}

/// Hierarchical, because the categories screen renders a path
/// ("Choy va qahva" under "Ichimliklar / Issiq") and a product count per row.
model Category {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  parentId       String? @map("parent_id") @db.Uuid

  name        String
  description String?

  /// Materialised ancestor path, maintained on write. The screen shows it on
  /// every row, and recomputing it per row would be a recursive query per
  /// category — the classic N+1 that turns an 18-row list into 40 queries.
  path String @default("")

  /// Root is 1. Capped at MAX_CATEGORY_DEPTH in the service.
  depth Int @default(1) @db.SmallInt

  sortOrder  Int          @default(0) @map("sort_order")
  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([organizationId, id])
  @@index([organizationId, parentId])
  @@index([organizationId, status])
  @@map("category")
}

/// Shared identity. What is actually sold is a ProductVariant — see §10.2:
/// every product has at least one, so inventory, sale lines and purchase lines
/// can all point at a single foreign key forever.
model Product {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  categoryId     String? @map("category_id") @db.Uuid

  name        String
  description String?
  brand       String?

  /// URLs only. Binaries live in object storage; PostgreSQL stores the pointer.
  imageUrls String[] @default([]) @map("image_urls")

  /// Presentation only: false hides the variant editor and edits the single
  /// default variant inline. Authorization and inventory never branch on it.
  hasVariants Boolean @default(false) @map("has_variants")

  status     ProductStatus @default(ACTIVE)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(6)

  /// Optimistic concurrency for the edit form — two managers in two tabs must
  /// not silently overwrite each other.
  version Int @default(0)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@unique([organizationId, id])
  @@index([organizationId, categoryId])
  @@index([organizationId, status, archivedAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("product")
}

model ProductVariant {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  /// Uppercased and trimmed on write; unique per organization among live rows.
  sku String

  /// Digits only, optional. The POS scan path is a single index hit on
  /// (organization_id, barcode).
  barcode String?

  /// null for the default variant of a simple product. For a variant product
  /// it is the rendered option combination, e.g. "Qora / S".
  name String?

  /// { "Rang": "Qora", "O'lcham": "S" }. A JSONB map rather than an
  /// attribute/value/assignment triple: the variants screen only ever renders
  /// the combination, and three tables would buy nothing the screen uses.
  attributes Json @default("{}")

  unit Unit @default(PIECE)

  /// Money is BIGINT minor units of the organization currency (§8). UZS has
  /// exponent 0, so 24000 means 24 000 so'm.
  purchasePrice BigInt @default(0) @map("purchase_price")
  sellingPrice  BigInt @map("selling_price")

  /// "Minimal qoldiq · 5 dona" on the product screen. Drives the low-stock
  /// badge that Sprint 4 computes; nothing here reads stock.
  minStock Decimal @default(0) @map("min_stock") @db.Decimal(14, 3)

  /// Exactly one per product, auto-created. Lets a simple product be edited as
  /// if it had no variants while the schema always has one to point at.
  isDefault Boolean @default(false) @map("is_default")

  status     ProductStatus @default(ACTIVE)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(6)
  version    Int           @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  levels        InventoryLevel[]
  movements     InventoryMovement[]
  countItems    InventoryCountItem[]
  transferItems StockTransferItem[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  returnItems   ReturnItem[]

  @@unique([organizationId, id])
  @@index([organizationId, barcode])
  @@index([organizationId, sku])
  @@index([productId])
  @@map("product_variant")
}

// ──────────────────────────────────────────────────────────────────────────
// Inventory (Sprint 4)
// ──────────────────────────────────────────────────────────────────────────

/// The ledger's vocabulary — docs/ARCHITECTURE.md §3.4. The sign each type may
/// carry is enforced by a CHECK in the migration, so a PURCHASE that removes
/// stock cannot be written even by raw SQL.
enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_CORRECTION
}

enum InventoryCountStatus {
  DRAFT
  COUNTING
  FINALIZED
  CANCELLED
}

enum InventoryCountScope {
  FULL
  PARTIAL
  CATEGORY
}

enum StockTransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

/// The projection — fast to read, rebuildable from the ledger (§9.1).
///
/// This is the row every sale locks. It is deliberately narrow: one row per
/// (warehouse, variant), no history, no joins needed to answer "can I sell
/// this right now".
model InventoryLevel {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  warehouseId      String @map("warehouse_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  /// NUMERIC(14,3): 1.5 kg of rice is a real quantity. No CHECK (quantity >= 0)
  /// — negative stock is a per-warehouse policy enforced by the conditional
  /// UPDATE in InventoryService.apply(), not a blanket constraint.
  quantity Decimal @default(0) @db.Decimal(14, 3)

  /// Moving weighted average, minor units (§8.6). Recomputed inside the same
  /// UPDATE that moves the quantity, so the two can never disagree.
  avgCost BigInt @default(0) @map("avg_cost")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [productVariantId], references: [id])

  /// The row that gets locked on every sale line.
  @@unique([warehouseId, productVariantId])
  @@unique([organizationId, id])
  @@index([organizationId, productVariantId])
  @@map("inventory_level")
}

/// The truth — append-only (§9.1). UPDATE and DELETE are blocked by trigger,
/// so a careless Prisma call fails loudly instead of silently rewriting the
/// history that every stock number depends on.
model InventoryMovement {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  warehouseId      String                @map("warehouse_id") @db.Uuid
  productVariantId String                @map("product_variant_id") @db.Uuid
  type             InventoryMovementType

  /// Signed. The sign must match the type — see ck_movement_sign.
  quantityDelta Decimal @map("quantity_delta") @db.Decimal(14, 3)

  /// The level's value after this movement. Makes "what was the stock on
  /// 3 September" a single indexed row read instead of a running sum.
  quantityAfter Decimal @map("quantity_after") @db.Decimal(14, 3)

  unitCost BigInt? @map("unit_cost")

  /// The business event that caused this: 'adjustment' | 'inventory_count' |
  /// 'stock_transfer' | 'sale' | 'purchase' | 'return' | 'onboarding'.
  sourceType String  @map("source_type")
  sourceId   String? @map("source_id") @db.Uuid

  reason String?
  note   String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([organizationId, id])
  @@index([organizationId, productVariantId, createdAt(sort: Desc)])
  @@index([organizationId, warehouseId, createdAt(sort: Desc)])
  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([sourceType, sourceId])
  @@map("inventory_movement")
}

/// A stocktake. Only finalization moves stock (§9.5) — counting itself never
/// locks the catalogue, because freezing a shop's entire stock for the
/// duration of a stocktake is not a workable product.
model InventoryCount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  warehouseId    String @map("warehouse_id") @db.Uuid

  countNumber String               @map("count_number")
  status      InventoryCountStatus @default(DRAFT)
  scope       InventoryCountScope  @default(FULL)

  /// Set only when scope = CATEGORY.
  categoryId String? @map("category_id") @db.Uuid

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdBy   String  @map("created_by") @db.Uuid
  finalizedBy String? @map("finalized_by") @db.Uuid
  note        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  items     InventoryCountItem[]

  @@unique([organizationId, countNumber])
  @@unique([organizationId, id])
  @@index([organizationId, warehouseId, status])
  @@map("inventory_count")
}

model InventoryCountItem {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  inventoryCountId String @map("inventory_count_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  /// Snapshotted when the line was generated. Kept for the report — it is
  /// deliberately NOT what the correction is computed from (§9.5).
  expectedQuantity Decimal @map("expected_quantity") @db.Decimal(14, 3)

  /// null means "not counted yet", which is not the same as counted zero.
  /// Conflating the two destroys inventory, so null lines are skipped.
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(14, 3)

  /// avg_cost at line generation, so shrinkage can be valued in money.
  unitCost BigInt? @map("unit_cost")

  countedBy String?   @map("counted_by") @db.Uuid
  countedAt DateTime? @map("counted_at") @db.Timestamptz(6)

  /// The correction actually applied at finalization. Null until then.
  appliedDelta Decimal? @map("applied_delta") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  count   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([inventoryCountId, productVariantId])
  @@unique([organizationId, id])
  @@index([organizationId, inventoryCountId])
  @@map("inventory_count_item")
}

/// Stock moving between warehouses. Goods in transit belong to neither
/// warehouse's sellable stock, which is why TRANSFER_OUT lands at send time
/// rather than at receive (§9.6).
model StockTransfer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  transferNumber  String              @map("transfer_number")
  fromWarehouseId String              @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String              @map("to_warehouse_id") @db.Uuid
  status          StockTransferStatus @default(DRAFT)

  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  receivedAt  DateTime? @map("received_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdBy  String  @map("created_by") @db.Uuid
  sentBy     String? @map("sent_by") @db.Uuid
  receivedBy String? @map("received_by") @db.Uuid
  note       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  fromWarehouse Warehouse           @relation("TransferOut", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferIn", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, fromWarehouseId])
  @@index([organizationId, toWarehouseId])
  @@map("stock_transfer")
}

model StockTransferItem {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  stockTransferId  String @map("stock_transfer_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  quantity Decimal @db.Decimal(14, 3)

  /// Shrinkage in transit is real, so received may be less than sent. The
  /// difference is written off at the source with a reason, never silently
  /// dropped.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)

  /// Cost travels with the goods, so the destination's moving average is not
  /// polluted by a zero-cost arrival.
  unitCost BigInt @default(0) @map("unit_cost")

  transfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([stockTransferId, productVariantId])
  @@unique([organizationId, id])
  @@map("stock_transfer_item")
}

/// Gapless per-store document numbers (§25.6). A row-locked counter, not a
/// sequence: a receipt number with gaps is a question from a tax inspector.
model DocumentCounter {
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  documentType   String @map("document_type")
  periodKey      String @map("period_key")
  nextValue      BigInt @default(1) @map("next_value")

  @@id([organizationId, storeId, documentType, periodKey])
  @@map("document_counter")
}

// ──────────────────────────────────────────────────────────────────────────
// Selling (Sprint 5)
// ──────────────────────────────────────────────────────────────────────────

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

/// Derived in the return transaction from returned vs sold quantity, and
/// denormalised purely so the sales list can filter without a subquery. The
/// original sale's own status is never rewritten by a return.
enum SaleReturnStatus {
  NONE
  PARTIAL
  FULL
}

/// IN is customer → store, OUT is store → customer. `amount` is always
/// positive and the direction carries the sign, so SUM(amount) stays
/// meaningful behind a WHERE instead of depending on every writer to get a
/// minus sign right.
enum PaymentDirection {
  IN
  OUT
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

/// A PostgreSQL enum, not a lookup table. Adding a provider costs one value;
/// a table with is_cash / affects_drawer / requires_provider flags would add
/// two joins to the checkout path to express the same three branches.
enum PaymentMethod {
  CASH
  CARD
  CLICK
  PAYME
  UZUM
  TRANSFER
  LOYALTY
  OTHER
}

enum ReceivableOrigin {
  SALE
  OPENING_BALANCE
  MANUAL
  EXCHANGE
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// Introduced in Sprint 5 because a credit sale needs somebody to owe the
/// money; Sprint 6 added groups, the birth date and the CRM screens.
///
/// There is deliberately no `debt` or `balance` column. A customer's debt is
/// SUM(remaining) over their open receivables, and a mutable balance is a
/// number that drifts from the documents it is supposed to summarise — which
/// is the one thing a debt module must never do.
model Customer {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  customerGroupId String? @map("customer_group_id") @db.Uuid

  fullName  String    @map("full_name")
  birthDate DateTime? @map("birth_date") @db.Date
  phone     String?
  email     String?   @db.Citext
  address   String?

  /// null = fall back to the group's limit; null there too = unlimited.
  creditLimit BigInt? @map("credit_limit")

  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group          CustomerGroup?       @relation(fields: [customerGroupId], references: [id])
  sales          Sale[]
  payments       Payment[]
  receivables    CustomerReceivable[]
  notes          CustomerNote[]
  returns        SaleReturn[]
  exchanges      Exchange[]
  loyaltyAccount LoyaltyAccount?

  @@unique([organizationId, id])
  @@index([organizationId, fullName])
  @@index([organizationId, phone])
  @@index([organizationId, customerGroupId])
  @@map("customer")
}

/// VIP, Ulgurji, Doimiy — the shop's own segmentation.
///
/// A group, not free-form tags: the design's customer screen shows one badge
/// per customer, and a group carries a discount and a credit limit that a tag
/// could not. Many-to-many tags would be a join table serving a screen that
/// does not exist.
model CustomerGroup {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String
  description String?

  /// Applied at checkout from Sprint 9; stored now so a group created today
  /// already carries the number that sprint will read.
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)

  /// The fallback when the customer has none of their own.
  creditLimit BigInt? @map("credit_limit")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customers Customer[]

  @@unique([organizationId, id])
  @@map("customer_group")
}

/// Dated, attributed notes rather than one overwritable text field: "called,
/// promised Friday" is a log, and the previous entry is the part that matters
/// when the promise is not kept.
model CustomerNote {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  body String

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@map("customer_note")
}

/// A completed sale is a historical document. Every figure on it is stored,
/// never recomputed at read time: a receipt reprinted next year must say what
/// it said on the day, whatever has happened to the price list since.
model Sale {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid

  /// Which stock this sale drew from. Recorded on the sale, not inferred at
  /// return time, because a store's default warehouse can change.
  warehouseId String @map("warehouse_id") @db.Uuid

  customerId String? @map("customer_id") @db.Uuid

  /// Human receipt number, unique per store.
  saleNumber String @map("sale_number")

  status       SaleStatus       @default(DRAFT)
  returnStatus SaleReturnStatus @default(NONE) @map("return_status")

  /// All money is BIGINT minor units (§8). Every one of these is computed by
  /// the server; none is ever read from the request.
  subtotalAmount      BigInt @default(0) @map("subtotal_amount")
  orderDiscountAmount BigInt @default(0) @map("order_discount_amount")
  taxAmount           BigInt @default(0) @map("tax_amount")
  roundingAdjustment  BigInt @default(0) @map("rounding_adjustment")
  totalAmount         BigInt @default(0) @map("total_amount")

  /// Sum of this sale's payment allocations, maintained inside the checkout
  /// transaction so the CHECK below can hold.
  paidAmount BigInt @default(0) @map("paid_amount")

  /// The part pushed onto a receivable. paid + credit = total, or the sale is
  /// not COMPLETED — a CHECK, not a convention.
  creditAmount   BigInt @default(0) @map("credit_amount")
  refundedAmount BigInt @default(0) @map("refunded_amount")

  /// COGS snapshot: the sum of the lines' unit_cost x quantity at the moment
  /// of sale. Margin is then a subtraction on stored values rather than a
  /// lookup of a cost that has since moved.
  costAmount BigInt @default(0) @map("cost_amount")

  /// Which promotion produced the order discount, if one did. Reporting needs
  /// to attribute a discount to the campaign that caused it.
  promotionId    String? @map("promotion_id") @db.Uuid
  discountReason String? @map("discount_reason")
  note           String?

  createdBy   String    @map("created_by") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  /// Offline hooks (§10.5). Four columns and a header are the whole offline
  /// story; they cost nothing today and make a replayed queue safe later.
  clientId        String?   @map("client_id") @db.Uuid
  clientCreatedAt DateTime? @map("client_created_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store                 Store               @relation(fields: [storeId], references: [id])
  customer              Customer?           @relation(fields: [customerId], references: [id])
  items                 SaleItem[]
  allocations           PaymentAllocation[]
  receivable            CustomerReceivable?
  returns               SaleReturn[]
  exchangeAsReplacement Exchange?           @relation("ExchangeSale")

  @@unique([organizationId, id])
  @@unique([organizationId, storeId, saleNumber])
  @@index([organizationId, storeId, completedAt(sort: Desc)])
  @@index([organizationId, customerId, completedAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, createdBy, completedAt(sort: Desc)])
  @@map("sale")
}

model SaleItem {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  saleId           String @map("sale_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  /// What the receipt said. Immune to a later rename, which is the entire
  /// point: a customer holding a printed receipt must be able to match it.
  nameSnapshot String @map("name_snapshot")
  skuSnapshot  String @map("sku_snapshot")

  quantity Decimal @db.Decimal(14, 3)

  /// Server-resolved from the catalogue, or overridden with permission.
  unitPrice   BigInt @map("unit_price")
  grossAmount BigInt @map("gross_amount")

  lineDiscountAmount     BigInt @default(0) @map("line_discount_amount")
  allocatedOrderDiscount BigInt @default(0) @map("allocated_order_discount")
  netAmount              BigInt @map("net_amount")

  /// avg_cost at the moment of sale. Stored per line, because the level's
  /// average moves with the next delivery.
  unitCost BigInt @map("unit_cost")

  returnedQuantity Decimal @default(0) @map("returned_quantity") @db.Decimal(14, 3)
  refundedAmount   BigInt  @default(0) @map("refunded_amount")

  /// Which ITEM-scope promotion produced this line's discount, if one did.
  promotionId String? @map("promotion_id") @db.Uuid

  position Int @db.SmallInt

  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [productVariantId], references: [id])
  returnItems ReturnItem[]

  @@unique([organizationId, id])
  @@unique([saleId, position])
  @@index([organizationId, productVariantId])
  @@map("sale_item")
}

/// Money moved: how much, by which method. What it settled is in
/// PaymentAllocation — one payment can pay for several things, and a debt
/// payment is the same two tables as a sale payment.
model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  customerId     String? @map("customer_id") @db.Uuid

  direction PaymentDirection
  method    PaymentMethod

  /// Always positive; `direction` carries the sign.
  amount BigInt

  status PaymentStatus @default(COMPLETED)

  /// External transaction id, for the providers that have one. No
  /// provider-specific column ever reaches the core schema.
  providerRef  String? @map("provider_ref")
  providerMeta Json    @default("{}") @map("provider_meta")

  receivedBy String  @map("received_by") @db.Uuid
  note       String?

  idempotencyKey String? @map("idempotency_key")
  clientId       String? @map("client_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    Customer?           @relation(fields: [customerId], references: [id])
  allocations PaymentAllocation[]

  @@unique([organizationId, id])
  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@index([organizationId, storeId, createdAt(sort: Desc)])
  @@index([organizationId, method, createdAt(sort: Desc)])
  @@map("payment")
}

/// Append-only. Exactly one of sale/receivable/return is set — a CHECK, not a
/// polymorphic (target_type, target_id) pair, so the database still verifies
/// that the thing being paid for exists.
model PaymentAllocation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  paymentId      String @map("payment_id") @db.Uuid

  saleId       String? @map("sale_id") @db.Uuid
  receivableId String? @map("receivable_id") @db.Uuid
  returnId     String? @map("return_id") @db.Uuid

  amount BigInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment    Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale       Sale?               @relation(fields: [saleId], references: [id])
  receivable CustomerReceivable? @relation(fields: [receivableId], references: [id])
  saleReturn SaleReturn?         @relation(fields: [returnId], references: [id])

  @@unique([organizationId, id])
  @@index([saleId])
  @@index([receivableId])
  @@index([returnId])
  @@index([paymentId])
  @@map("payment_allocation")
}

/// One document per debt, never a running balance on the customer.
///
/// `remaining_amount` is deliberately NOT a column: the architecture proposed
/// a STORED generated column so it could not drift from its inputs, and not
/// storing it at all achieves that more simply — nothing stored is nothing
/// that can drift, and Prisma cannot declare a generated column anyway.
/// A CHECK keeps paid + written_off within the original, so over-payment is an
/// error rather than a negative balance.
model CustomerReceivable {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  /// Unique: one sale cannot spawn two debts, whatever a retrying client does.
  saleId String? @unique @map("sale_id") @db.Uuid

  origin ReceivableOrigin @default(SALE)

  originalAmount   BigInt @map("original_amount")
  paidAmount       BigInt @default(0) @map("paid_amount")
  writtenOffAmount BigInt @default(0) @map("written_off_amount")

  status ReceivableStatus @default(OPEN)

  issuedAt DateTime  @map("issued_at") @db.Timestamptz(6)
  dueDate  DateTime  @map("due_date") @db.Date
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  note String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    Customer            @relation(fields: [customerId], references: [id])
  sale        Sale?               @relation(fields: [saleId], references: [id])
  allocations PaymentAllocation[]

  @@unique([organizationId, id])
  @@index([organizationId, customerId, status])
  @@index([organizationId, dueDate])
  @@map("customer_receivable")
}

/// Written in the SAME transaction as the work it guards, so "the sale
/// committed but the idempotency record did not" cannot happen (§26.2).
model IdempotencyRecord {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  key      String
  endpoint String

  /// sha256(method + path + canonical body). A different body under the same
  /// key is a client bug, and answering it with the first response would be
  /// worse than an error.
  requestHash String @map("request_hash")

  status IdempotencyStatus @default(IN_PROGRESS)

  responseStatus Int?    @map("response_status")
  responseBody   Json?   @map("response_body")
  resourceId     String? @map("resource_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

// ──────────────────────────────────────────────────────────────────────────
// Procurement (Sprint 7)
// ──────────────────────────────────────────────────────────────────────────

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String
  contactName String? @map("contact_name")
  phone       String?
  email       String? @db.Citext
  address     String?
  notes       String?

  /// How long this supplier gives us to pay. Drives the expected payment date
  /// on the payables report.
  paymentTermDays Int @default(0) @map("payment_term_days") @db.SmallInt

  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchases Purchase[]
  payments  SupplierPayment[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@map("supplier")
}

/// A purchase order, and later a receipt of goods.
///
/// Payment state is separate from receipt state: a purchase can be RECEIVED
/// and unpaid, or paid and not yet delivered. Conflating them into one status
/// is why so many systems cannot answer "what do we owe".
model Purchase {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid

  /// Where the goods land when received.
  warehouseId String @map("warehouse_id") @db.Uuid
  supplierId  String @map("supplier_id") @db.Uuid

  purchaseNumber        String         @map("purchase_number")
  status                PurchaseStatus @default(DRAFT)
  supplierInvoiceNumber String?        @map("supplier_invoice_number")

  orderedAt   DateTime? @map("ordered_at") @db.Timestamptz(6)
  expectedAt  DateTime? @map("expected_at") @db.Timestamptz(6)
  receivedAt  DateTime? @map("received_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  /// Money is BIGINT minor units. subtotal is the sum of the lines; shipping
  /// and discount sit at the header and are NOT allocated into unit costs —
  /// landed cost needs an allocation basis nobody has specified yet (§15.5).
  subtotalAmount BigInt @default(0) @map("subtotal_amount")
  discountAmount BigInt @default(0) @map("discount_amount")
  shippingAmount BigInt @default(0) @map("shipping_amount")
  totalAmount    BigInt @default(0) @map("total_amount")

  /// Sum of this purchase's supplier payments, maintained under a guard.
  /// `remaining` is total - paid, computed, never stored — the same reasoning
  /// as the customer receivable.
  paidAmount BigInt @default(0) @map("paid_amount")

  note         String?
  cancelReason String? @map("cancel_reason")

  createdBy  String  @map("created_by") @db.Uuid
  receivedBy String? @map("received_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  store    Store             @relation(fields: [storeId], references: [id])
  items    PurchaseItem[]
  payments SupplierPayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("purchase")
}

model PurchaseItem {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  purchaseId       String @map("purchase_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  orderedQuantity  Decimal @map("ordered_quantity") @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)

  /// The supplier's unit price. Historical: a later price change must not
  /// rewrite what this delivery cost.
  unitCost   BigInt @map("unit_cost")
  lineAmount BigInt @map("line_amount")

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([organizationId, id])
  @@unique([purchaseId, productVariantId])
  @@index([organizationId, productVariantId])
  @@map("purchase_item")
}

/// Deliberately NOT the same table as customer `Payment` — docs/ARCHITECTURE.md §15.4.
///
/// They look symmetrical and are not: direction, targets, till association,
/// permissions, reporting and volume all differ. Unifying them would cost a
/// direction flag plus a target discriminator plus a permission branch plus a
/// reporting branch — four conditionals to avoid one small table.
model SupplierPayment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  supplierId     String @map("supplier_id") @db.Uuid

  /// null = paid on account rather than against one invoice.
  purchaseId String? @map("purchase_id") @db.Uuid

  method PaymentMethod
  amount BigInt

  reference String?
  note      String?

  paidAt    DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid

  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@unique([organizationId, id])
  @@index([organizationId, supplierId, paidAt(sort: Desc)])
  @@index([purchaseId])
  @@map("supplier_payment")
}

// ──────────────────────────────────────────────────────────────────────────
// Returns and exchanges (Sprint 8)
// ──────────────────────────────────────────────────────────────────────────

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CHANGED_MIND
  EXPIRED
  OTHER
}

/// Whether the goods can go back on the shelf. DAMAGED never restocks, so
/// "returned" and "written off" stay different facts — merging them hides
/// shrinkage.
enum ItemCondition {
  SELLABLE
  DAMAGED
}

enum ExchangeSettlement {
  CUSTOMER_PAID
  REFUNDED
  EVEN
  CREDITED_TO_DEBT
}

/// A compensating transaction. The original sale is never deleted and its
/// figures are never rewritten; only `refunded_amount` and `return_status`
/// move, and both are derived from the returns that reference it.
///
/// Physically `sale_return`, because `return` is reserved in PostgreSQL.
model SaleReturn {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid
  saleId         String @map("sale_id") @db.Uuid

  /// Where restocked goods go. Recorded rather than inferred, because a
  /// store's default warehouse can change between the sale and the return.
  warehouseId String  @map("warehouse_id") @db.Uuid
  customerId  String? @map("customer_id") @db.Uuid

  returnNumber String       @map("return_number")
  reason       ReturnReason
  reasonNote   String?      @map("reason_note")

  /// Money actually handed back.
  refundAmount BigInt @map("refund_amount")

  /// Written off an open receivable instead of refunded (§13.5). Refunding
  /// cash to somebody who still owes you money is a mistake the system should
  /// not make on its own.
  creditOffsetAmount BigInt @default(0) @map("credit_offset_amount")

  /// Set when this return is one leg of an exchange.
  exchangeId String? @unique @map("exchange_id") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale        Sale                @relation(fields: [saleId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  items       ReturnItem[]
  allocations PaymentAllocation[]
  exchange    Exchange?           @relation("ExchangeReturn", fields: [exchangeId], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, storeId, returnNumber])
  @@index([organizationId, saleId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, customerId, createdAt(sort: Desc)])
  @@map("sale_return")
}

model ReturnItem {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  returnId         String @map("return_id") @db.Uuid
  saleItemId       String @map("sale_item_id") @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid

  quantity Decimal @db.Decimal(14, 3)

  /// What this unit is actually worth back: the line's NET share, not the list
  /// price. A customer who bought at a discount is refunded at that discount.
  unitRefundAmount BigInt @map("unit_refund_amount")
  refundAmount     BigInt @map("refund_amount")

  restock   Boolean       @default(true)
  condition ItemCondition @default(SELLABLE)

  saleReturn SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id])
  variant    ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([organizationId, id])
  @@unique([returnId, saleItemId])
  @@index([organizationId, productVariantId])
  @@map("return_item")
}

/// A composite, not a third kind of line-item document (§14.1).
///
/// An exchange IS a return plus a sale. Modelling it separately would
/// duplicate the stock logic, the refund logic and the debt logic that both
/// already implement correctly. This row exists only to link the pair, record
/// the settlement, and stop reporting counting the replacement as organic
/// revenue.
model Exchange {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storeId        String @map("store_id") @db.Uuid

  exchangeNumber String @map("exchange_number")

  returnId          String @unique @map("return_id") @db.Uuid
  replacementSaleId String @unique @map("replacement_sale_id") @db.Uuid

  customerId String? @map("customer_id") @db.Uuid

  returnedValue    BigInt @map("returned_value")
  replacementValue BigInt @map("replacement_value")

  /// replacement − returned. Positive: the customer pays. Negative: refund.
  netAmount BigInt @map("net_amount")

  settlement ExchangeSettlement

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  saleReturn      SaleReturn? @relation("ExchangeReturn")
  replacementSale Sale        @relation("ExchangeSale", fields: [replacementSaleId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, storeId, exchangeNumber])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("exchange")
}

// ──────────────────────────────────────────────────────────────────────────
// Promotions and loyalty (Sprint 9)
// ──────────────────────────────────────────────────────────────────────────

enum PromotionType {
  PERCENT_OFF
  FIXED_OFF
}

enum PromotionScope {
  ITEM
  ORDER
}

enum PromotionTarget {
  ALL
  CATEGORY
  PRODUCT
}

enum LoyaltyTransactionType {
  EARN
  SPEND
  ADJUSTMENT
  EXPIRY
}

/// A promotion is a rule; the discount it produces is a money amount stored on
/// the sale. The rule can change tomorrow without altering what yesterday's
/// receipt says.
///
/// BUY_X_GET_Y from the draft is deliberately absent: it needs a free-item
/// line, its own returns behaviour and a stock effect, none of which the
/// design specifies. PERCENT_OFF and FIXED_OFF cover every screen that exists.
model Promotion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name        String
  description String?

  type  PromotionType
  scope PromotionScope

  /// Percent (2dp) for PERCENT_OFF, minor units for FIXED_OFF. Which one it
  /// means is decided by `type`, never guessed.
  value Decimal @db.Decimal(14, 2)

  /// The order must reach this before an ORDER promotion applies.
  minSubtotal BigInt? @map("min_subtotal")

  /// A ceiling on a PERCENT_OFF, so "20% off" on a large basket cannot become
  /// an unbounded giveaway.
  maxDiscount BigInt? @map("max_discount")

  appliesTo PromotionTarget @default(ALL) @map("applies_to")

  /// Arrays rather than join tables: a promotion targets a handful of things,
  /// is read once per checkout, and is edited as a whole. Three join tables
  /// would buy referential integrity on a list the UI replaces wholesale.
  categoryIds      String[] @default([]) @map("category_ids") @db.Uuid
  productIds       String[] @default([]) @map("product_ids") @db.Uuid
  customerGroupIds String[] @default([]) @map("customer_group_ids") @db.Uuid

  startsAt DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(6)

  isActive Boolean @default(true) @map("is_active")

  /// Higher wins first; ties break on the larger computed value (§18.3).
  priority Int @default(0) @db.SmallInt

  maxUses   Int? @map("max_uses")
  usedCount Int  @default(0) @map("used_count")

  version Int @default(0)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, isActive, startsAt, endsAt])
  @@map("promotion")
}

/// The cached balance. Convenient, never authoritative.
///
/// Written only inside the same transaction as the LoyaltyTransaction that
/// changes it, and reconcilable against SUM(points_delta) — the same
/// projection-plus-ledger pattern as inventory, for the same reason.
model LoyaltyAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId     String @unique @map("customer_id") @db.Uuid

  pointsBalance  BigInt @default(0) @map("points_balance")
  lifetimeEarned BigInt @default(0) @map("lifetime_earned")
  lifetimeSpent  BigInt @default(0) @map("lifetime_spent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([organizationId, id])
  @@map("loyalty_account")
}

/// Append-only, like the inventory ledger and the payment allocations. A
/// points balance that can be edited is a currency anybody can print.
model LoyaltyTransaction {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  loyaltyAccountId String                 @map("loyalty_account_id") @db.Uuid
  type             LoyaltyTransactionType

  /// Signed, never zero.
  pointsDelta  BigInt @map("points_delta")
  balanceAfter BigInt @map("balance_after")

  saleId   String? @map("sale_id") @db.Uuid
  returnId String? @map("return_id") @db.Uuid

  reason String?

  /// Declared now so the ledger never needs migrating. Nothing writes it:
  /// expiry needs a policy — rolling window, calendar year, per-transaction
  /// FIFO — that has not been specified.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([loyaltyAccountId, createdAt(sort: Desc)])
  @@index([organizationId, saleId])
  @@map("loyalty_transaction")
}
